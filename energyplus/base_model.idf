 ! EnergyPlus Input Data File
 ! Eco-Loop Small Office Building — Baseline Model
 ! DOE Reference Small Office Building (Simplified)
 ! Total Conditioned Area: ~511 m²  (3-zone single storey)
 ! Climate: London, UK (Temperate)
 ! Version: EnergyPlus 23.x Compatible

 Version,23.2;

 !---------------------------------------------------------------------------
 ! SIMULATION CONTROL
 !---------------------------------------------------------------------------

 SimulationControl,
   No,                      !- Do Zone Sizing Calculation (no Autosize fields exist in this model - sizing periods aren't needed, and none are defined below)
   No,                      !- Do System Sizing Calculation
   No,                      !- Do Plant Sizing Calculation
   No,                      !- Run Simulation for Sizing Periods
   Yes;                     !- Run Simulation for Weather File Run Periods

 Building,
   EcoLoop_SmallOffice,     !- Name
   0.0,                     !- North Axis {deg}
   Suburbs,                 !- Terrain
   0.04,                    !- Loads Convergence Tolerance Value
   0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
   FullInteriorAndExterior, !- Solar Distribution
   25,                      !- Maximum Number of Warmup Days
   6;                       !- Minimum Number of Warmup Days

 Timestep, 6;               !- Number of Timesteps per Hour

 !---------------------------------------------------------------------------
 ! RUN PERIOD
 !---------------------------------------------------------------------------

 RunPeriod,
   Single Day Simulation,   !- Name (kept to one representative summer day so a real
                            !- EnergyPlus run stays the same order of magnitude as the
                            !- thermodynamic fallback, and completes fast enough to click
                            !- through multiple demo cycles interactively)
   7,                       !- Begin Month
   15,                      !- Begin Day of Month
   ,                        !- Begin Year
   7,                       !- End Month
   15,                      !- End Day of Month
   ,                        !- End Year
   Wednesday,               !- Day of Week for Start Day
   Yes,                     !- Use Weather File Holidays and Special Days
   Yes,                     !- Use Weather File DST Indicators
   Yes,                     !- Apply Weekend Holiday Rule
   Yes,                     !- Use Weather File Rain Indicators
   Yes;                     !- Use Weather File Snow Indicators

 !---------------------------------------------------------------------------
 ! SITE LOCATION (London Heathrow)
 !---------------------------------------------------------------------------

 Site:Location,
   LONDON_HEATHROW,         !- Name
   51.48,                   !- Latitude {deg}
   -0.45,                   !- Longitude {deg}
   0.0,                     !- Time Zone {hr}
   25.3;                    !- Elevation {m}

 !---------------------------------------------------------------------------
 ! SCHEDULE TYPES
 !---------------------------------------------------------------------------

 ScheduleTypeLimits,
   Any Number;              !- Name

 ScheduleTypeLimits,
   Fraction,                !- Name
   0.0,                     !- Lower Limit Value
   1.0,                     !- Upper Limit Value
   CONTINUOUS;              !- Numeric Type

 ScheduleTypeLimits,
   Temperature,             !- Name
   -60,                     !- Lower Limit Value
   200,                     !- Upper Limit Value
   CONTINUOUS;              !- Numeric Type

 ScheduleTypeLimits,
   On/Off,                  !- Name
   0,                       !- Lower Limit Value
   1,                       !- Upper Limit Value
   DISCRETE;                !- Numeric Type

 !---------------------------------------------------------------------------
 ! ALWAYS ON/OFF SCHEDULES
 !---------------------------------------------------------------------------

 Schedule:Compact,
   ALWAYS_ON,               !- Name
   Fraction,                !- Schedule Type Limits Name
   Through: 12/31,          !- Field 1
   For: AllDays,            !- Field 2
   Until: 24:00,            !- Field 3
   1.0;                     !- Field 4

 Schedule:Compact,
   ALWAYS_OFF,              !- Name
   Fraction,                !- Schedule Type Limits Name
   Through: 12/31,          !- Field 1
   For: AllDays,            !- Field 2
   Until: 24:00,            !- Field 3
   0.0;                     !- Field 4

