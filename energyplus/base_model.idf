   MediumRough,             !- Roughness
   0.1016,                  !- Thickness {m}
   0.53,                    !- Conductivity {W/m-K}
   1280.0,                  !- Density {kg/m3}
   840.0;                   !- Specific Heat {J/kg-K}

 WindowMaterial:SimpleGlazingSystem,
   Simple Window U=2.1,     !- Name
   2.1,                     !- U-Factor {W/m2-K}
   0.4;                     !- Solar Heat Gain Coefficient

 Construction,
   Exterior Wall,           !- Name
   F08 Metal surface,       !- Outside Layer
   I01 25mm insulation board, !- Layer 2
   Concrete Block,          !- Layer 3
   G01a 19mm gypsum board;  !- Layer 4

 Construction,
   Exterior Roof,           !- Name
   F08 Metal surface,       !- Outside Layer
