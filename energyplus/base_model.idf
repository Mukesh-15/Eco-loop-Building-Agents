 !---------------------------------------------------------------------------
 ! MATERIALS AND CONSTRUCTIONS
 !---------------------------------------------------------------------------

 Material,
   Concrete Block,          !- Name
   MediumRough,             !- Roughness
   0.2032,                  !- Thickness {m}
   0.51,                    !- Conductivity {W/m-K}
   1400.0,                  !- Density {kg/m3}
   1000.0;                  !- Specific Heat {J/kg-K}

